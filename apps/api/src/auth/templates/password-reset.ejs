<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>Reset your Wiloplay password</title>
  </head>
  <body style="margin:0;padding:0;background:#f1f5ef;font-family:Arial,Helvetica,sans-serif;color:#142016;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f1f5ef;padding:32px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:560px;background:#0d160f;border:1px solid #263b29;border-radius:20px;overflow:hidden;">
            <tr>
              <td style="padding:30px 34px 18px;">
                <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                  <tr>
                    <td align="center" width="38" height="38" style="width:38px;height:38px;border-radius:11px;background:#b5ff72;color:#10200c;font-size:20px;font-weight:bold;">♫</td>
                    <td style="padding-left:11px;color:#f2f8ef;font-size:20px;font-weight:bold;letter-spacing:-1px;">wiloplay<span style="color:#b5ff72;">.</span></td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td style="padding:14px 34px 34px;">
                <p style="margin:0 0 12px;color:#b5ff72;font-size:11px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;">PASSWORD RESET</p>
                <h1 style="margin:0;color:#f2f8ef;font-size:30px;line-height:1.2;letter-spacing:-1px;">Choose a new password.</h1>
                <p style="margin:16px 0 0;color:#bdcbbd;font-size:15px;line-height:1.7;">Hi <strong style="color:#f2f8ef;"><%= name %></strong>, use this code to reset your Wiloplay password.</p>
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:26px 0 18px;">
                  <tr>
                    <td align="center" style="background:#17251a;border:1px solid #35553a;border-radius:14px;padding:20px 12px;">
                      <span style="color:#c6ff9a;font-family:'Courier New',monospace;font-size:34px;font-weight:bold;letter-spacing:10px;"><%= code %></span>
                    </td>
                  </tr>
                </table>
                <p style="margin:0;color:#9eaf9f;font-size:13px;line-height:1.7;">This code expires in <strong style="color:#e8f4e3;">10 minutes</strong> and can only be used once.</p>
                <% if (webOrigin) { %>
                  <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin-top:24px;">
                    <tr>
                      <td align="center" style="background:#b5ff72;border-radius:10px;">
                        <a href="<%= webOrigin %>" style="display:inline-block;padding:13px 20px;color:#10200c;font-size:14px;font-weight:bold;text-decoration:none;">Open Wiloplay&nbsp; &rarr;</a>
                      </td>
                    </tr>
                  </table>
                <% } %>
                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top:28px;">
                  <tr>
                    <td style="border-top:1px solid #263b29;padding-top:18px;color:#839386;font-size:12px;line-height:1.7;">If you didn&apos;t request a password reset, you can safely ignore this email. Never share this code with anyone.
                      <% if (webOrigin) { %>
                        <br><br><a href="<%= webOrigin %>/privacy" style="color:#b5ff72;text-decoration:none;">Privacy</a>&nbsp;&nbsp;·&nbsp;&nbsp;<a href="<%= webOrigin %>/terms" style="color:#b5ff72;text-decoration:none;">Terms</a>
                      <% } %>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
          <p style="margin:18px 0 0;color:#879387;font-size:11px;line-height:1.6;">A little more music. A lot more you.<br>Sent by Wiloplay</p>
        </td>
      </tr>
    </table>
  </body>
</html>
